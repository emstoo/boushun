{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pullPolicy", "tag", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "allowedCIDRs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/([0-9]|[12][0-9]|3[0-2])$"
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "retain", "existingClaim", "accessModes", "size", "storageClassName", "annotations"],
      "properties": {
        "enabled": { "type": "boolean" },
        "retain": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "accessModes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "size": { "type": "string", "minLength": 1 },
        "storageClassName": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "automount", "annotations", "name"],
      "properties": {
        "create": { "type": "boolean" },
        "automount": { "type": "boolean" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "name": { "type": "string" }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create"],
      "properties": { "create": { "type": "boolean" } }
    },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "resources": { "type": "object" },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 }
        },
        "not": {
          "properties": {
            "name": {
              "enum": ["BOUSHUN_HOST", "BOUSHUN_PORT", "BOUSHUN_DATA_DIR", "BOUSHUN_ALLOWED_CIDRS"]
            }
          },
          "required": ["name"]
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "name": {
                  "enum": ["BOUSHUN_HOST", "BOUSHUN_PORT", "BOUSHUN_DATA_DIR", "BOUSHUN_ALLOWED_CIDRS"]
                }
              },
              "required": ["name"]
            },
            "then": {
              "properties": {
                "BOUSHUN_HOST, BOUSHUN_PORT, BOUSHUN_DATA_DIR, and BOUSHUN_ALLOWED_CIDRS are chart-managed": false
              },
              "required": ["BOUSHUN_HOST, BOUSHUN_PORT, BOUSHUN_DATA_DIR, and BOUSHUN_ALLOWED_CIDRS are chart-managed"]
            }
          }
        ]
      }
    },
    "extraVolumes": { "type": "array", "items": { "type": "object" } },
    "extraVolumeMounts": { "type": "array", "items": { "type": "object" } }
  },
  "required": [
    "image",
    "imagePullSecrets",
    "nameOverride",
    "fullnameOverride",
    "port",
    "allowedCIDRs",
    "persistence",
    "serviceAccount",
    "rbac",
    "podAnnotations",
    "podLabels",
    "resources",
    "nodeSelector",
    "tolerations",
    "affinity",
    "topologySpreadConstraints",
    "extraEnv",
    "extraVolumes",
    "extraVolumeMounts"
  ]
}
